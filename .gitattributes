# Auto detect text files and perform LF normalization
* text=auto

# Java source files - LF line endings
*.java text eol=lf
*.xml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.properties text eol=lf

# Binary files - no processing
*.jar binary
*.class binary
*.png binary
*.jpg binary
